#!/usr/bin/env python3
# encode - numbered frames -> H.264 MP4. Linux port of encode.swift (AVFoundation -> ffmpeg).
# usage: encode <frames_dir> <fps> <out.mp4> [bitrate_mbps=24]
#   frames f_<n>.png | f_<n>.jpg ordered by n; other files ignored.
#   output H.264 High, BT.709 tags, keyframe every 2 s, constant frame rate.
# render_film.sh calls this with an ABSOLUTE output path.

import glob
import os
import re
import shutil
import subprocess
import sys
import tempfile

FRAME_RE = re.compile(r"^f_(\d+)\.(png|jpg|jpeg)$", re.IGNORECASE)


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def main(argv):
    if len(argv) < 3:
        die("usage: encode <frames_dir> <fps> <out.mp4> [bitrate_mbps=24]")
    frames_dir, out = argv[0], argv[2]
    try:
        fps = float(argv[1])
        if fps <= 0:
            raise ValueError
    except ValueError:
        die(f"fps must be a positive number, got {argv[1]!r}")
    mbps = float(argv[3]) if len(argv) > 3 else 24.0

    if not os.path.isdir(frames_dir):
        die(f"not a directory: {frames_dir}")
    found = []
    for name in os.listdir(frames_dir):
        m = FRAME_RE.match(name)
        if m:
            found.append((int(m.group(1)), os.path.join(frames_dir, name)))
    if not found:
        die(f"no f_<n>.png or f_<n>.jpg frames in {frames_dir}")
    found.sort(key=lambda t: t[0])
    idx = [n for n, _ in found]

    # A hole here silently shortens the film; render_film.sh gates on this too.
    if len(idx) > 1:
        steps = {b - a for a, b in zip(idx, idx[1:])}
        if len(steps) > 1:
            die(f"gap in the frame index (steps {sorted(steps)}) between f_{idx[0]} and f_{idx[-1]}")

    paths = [p for _, p in found]
    tmp = tempfile.mkdtemp(prefix="hfsaas_")
    ext = os.path.splitext(paths[0])[1].lower()
    try:
        for i, src in enumerate(paths):
            os.symlink(os.path.abspath(src), os.path.join(tmp, f"f_{i:06d}{ext}"))
        gop = max(1, round(fps * 2))
        cmd = [
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-framerate", str(fps), "-start_number", "0",
            "-i", os.path.join(tmp, f"f_%06d{ext}"),
            "-c:v", "libx264", "-profile:v", "high", "-pix_fmt", "yuv420p",
            "-b:v", f"{mbps}M", "-maxrate", f"{mbps * 2}M", "-bufsize", f"{mbps * 4}M",
            "-x264-params", f"keyint={gop}:min-keyint={gop}:scenecut=0",
            "-color_primaries", "bt709", "-color_trc", "bt709", "-colorspace", "bt709",
            "-fps_mode", "cfr", "-r", str(fps), "-movflags", "+faststart", out,
        ]
        p = subprocess.run(cmd, capture_output=True, text=True)
        if p.returncode != 0:
            die("ffmpeg failed:\n" + "\n".join(p.stderr.strip().splitlines()[-10:]))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print(f"encode  {len(paths)} frames @ {fps:g} fps -> {out}  "
          f"({len(paths) / fps:.2f} s, {os.path.getsize(out) / 1e6:.1f} MB)")


if __name__ == "__main__":
    main(sys.argv[1:])
