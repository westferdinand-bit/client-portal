#!/usr/bin/env python3
# extract <video> <out_dir> [step_s=0.5] [from_s=0] [to_s=end] [max_px=640]
# Sample a film at fixed time steps into small JPEGs you can open with Read.
# Linux port of extract.swift (AVFoundation -> ffmpeg). NOTE: this is the saas CLI (time steps),
# not the frame-sequence extract in the higgsfield-motion skill.
import glob, json, os, subprocess, sys

def die(m):
    print(f"error: {m}", file=sys.stderr); sys.exit(1)

a = sys.argv[1:]
if len(a) < 2:
    die("usage: extract <video> <out_dir> [step_s=0.5] [from_s=0] [to_s=end] [max_px=640]")
video, out_dir = a[0], a[1]
step = float(a[2]) if len(a) > 2 else 0.5
start = float(a[3]) if len(a) > 3 else 0.0
end_arg = a[4] if len(a) > 4 else None
max_px = int(a[5]) if len(a) > 5 else 640
if not os.path.isfile(video):
    die(f"file not found: {video}")
if step <= 0:
    die("step_s must be positive")

probe = subprocess.run(["ffprobe", "-v", "error", "-print_format", "json",
                        "-show_format", "-show_streams", "-select_streams", "v:0", video],
                       capture_output=True, text=True)
try:
    info = json.loads(probe.stdout)
    dur = float(info["format"]["duration"])
    w = int(info["streams"][0]["width"]); h = int(info["streams"][0]["height"])
except Exception:
    die(f"could not probe {video}")
end = float(end_arg) if end_arg not in (None, "end") else dur

os.makedirs(out_dir, exist_ok=True)
for old in glob.glob(os.path.join(out_dir, "t_*.jpg")):
    os.remove(old)

scale = []
if max_px and max(w, h) > max_px:
    scale = ["-vf", f"scale='if(gt(iw,ih),{max_px},-2)':'if(gt(iw,ih),-2,{max_px})'"]

n, t = 0, start
while t <= end + 1e-9:
    dest = os.path.join(out_dir, f"t_{t:07.2f}.jpg")
    p = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                        "-ss", f"{t:.6f}", "-i", video, *scale,
                        "-frames:v", "1", "-q:v", "3", dest], capture_output=True, text=True)
    if p.returncode == 0 and os.path.isfile(dest):
        n += 1
    t += step

if n == 0:
    die(f"extracted no frames from {video}")
print(f"extract  {os.path.basename(video)} -> {n} stills every {step:g} s "
      f"({start:g}-{end:.2f} s, max {max_px}px) in {out_dir}")
