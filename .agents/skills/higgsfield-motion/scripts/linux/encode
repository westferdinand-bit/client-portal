#!/usr/bin/env python3
# Encode a numbered PNG/JPEG frame sequence into an H.264 MP4 using ffmpeg. Picture only:
# for picture + sound in one pass use encode_av; to add audio to an existing MP4 use mux.
# usage: encode <frames_dir> <fps> <out.mp4> [bitrate_mbps=24] [--lenient]
#   frames  f_<n>.png | f_<n>.jpg (capture.mjs writes f_00000.png ...), ordered by n; other files ignored.
#   output  H.264 High, BT.709 primaries/transfer/matrix tags, a keyframe every 2 s, constant frame rate.
# Linux port of encode.swift (AVFoundation -> ffmpeg). Same CLI, same checks, same output shape.

import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _hfcommon import collect_frames, die, run, sequence_dir, x264_args  # noqa: E402


def main(argv):
    args = [a for a in argv if a != "--lenient"]
    lenient = "--lenient" in argv
    if len(args) < 3:
        die("usage: encode <frames_dir> <fps> <out.mp4> [bitrate_mbps=24] [--lenient]")

    frames_dir, fps_s, out = args[0], args[1], args[2]
    try:
        fps = float(fps_s)
        if fps <= 0:
            raise ValueError
    except ValueError:
        die(f"fps must be a positive number, got {fps_s!r}")
    mbps = float(args[3]) if len(args) > 3 else 24.0

    paths = collect_frames(frames_dir, lenient)
    tmp, pattern = sequence_dir(paths)
    try:
        run([
            "ffmpeg", "-hide_banner", "-y",
            "-framerate", str(fps),
            "-start_number", "0",
            "-i", os.path.join(tmp, pattern),
            *x264_args(fps, mbps),
            out,
        ])
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    size_mb = os.path.getsize(out) / 1e6
    print(f"encode  {len(paths)} frames @ {fps:g} fps -> {out}  "
          f"({len(paths) / fps:.2f} s, {size_mb:.1f} MB, target {mbps:g} Mbps)")


if __name__ == "__main__":
    main(sys.argv[1:])
