#!/usr/bin/env python3
# extract - turn generated footage (Seedance / Kling / any H.264 or HEVC clip) into an image sequence
# a __seek page can address frame-accurately. Headless Chromium has no H.264, and <video> seeking is
# not frame-deterministic.
# usage: extract <clip.mp4> <out_dir> [fps=native] [maxW=1920] [quality=0.9]
#   fps      "native" (default) = the clip's own rate: every source frame exactly once, no duplicates.
#            A number resamples.
#   out      <out_dir>/f_0000.jpg ... f_<n-1>.jpg (0-based, JPEG), plus <out_dir>/_clip.json.
#            Old f_*.jpg in out_dir are removed first, so a re-extract never mixes two takes.
# Linux port of extract.swift (AVFoundation -> ffmpeg). Same CLI and output contract.

import glob
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _hfcommon import die, media_duration, parse_rational, run, stream  # noqa: E402


def main(argv):
    if len(argv) < 2:
        die("usage: extract <clip.mp4> <out_dir> [fps=native] [maxW=1920] [quality=0.9]")
    clip, out_dir = argv[0], argv[1]
    fps_arg = argv[2] if len(argv) > 2 else "native"
    max_w = int(argv[3]) if len(argv) > 3 else 1920
    quality = float(argv[4]) if len(argv) > 4 else 0.9

    if not os.path.isfile(clip):
        die(f"clip not found: {clip}")

    v = stream(clip, "v")
    if not v:
        die(f"no video stream in {clip}")
    src_fps = parse_rational(v.get("avg_frame_rate") or v.get("r_frame_rate"), 0.0)
    if src_fps <= 0:
        die(f"could not read the frame rate of {clip}")
    w, h = int(v.get("width", 0)), int(v.get("height", 0))
    duration = media_duration(clip) or 0.0

    os.makedirs(out_dir, exist_ok=True)
    for old in glob.glob(os.path.join(out_dir, "f_*.jpg")):
        os.remove(old)

    out_w, out_h = w, h
    vf = []
    if max_w and w > max_w:
        out_w = max_w
        out_h = int(round(h * max_w / w / 2)) * 2
        vf.append(f"scale={out_w}:{out_h}")

    native = str(fps_arg).lower() == "native"
    out_fps = src_fps if native else float(fps_arg)
    if not native:
        vf.append(f"fps={out_fps}")

    # JPEG quality 0..1 -> ffmpeg -q:v 2 (best) .. 31 (worst)
    qv = max(2, min(31, round(2 + (1.0 - quality) * 29)))

    cmd = ["ffmpeg", "-hide_banner", "-y", "-i", clip]
    if vf:
        cmd += ["-vf", ",".join(vf)]
    if native:
        cmd += ["-fps_mode", "passthrough"]
    cmd += ["-q:v", str(qv), "-start_number", "0", os.path.join(out_dir, "f_%04d.jpg")]
    run(cmd)

    frames = len(glob.glob(os.path.join(out_dir, "f_*.jpg")))
    if frames == 0:
        die(f"extracted no frames from {clip}")

    meta = {
        "frames": frames,
        "fps": out_fps,
        "duration": frames / out_fps if out_fps else duration,
        "srcFps": src_fps,
        "w": w,
        "h": h,
        "outW": out_w,
        "outH": out_h,
        "first": 0,
        "pattern": "f_%04d.jpg",
    }
    with open(os.path.join(out_dir, "_clip.json"), "w") as fh:
        json.dump(meta, fh, indent=2)

    print(f"extract  {os.path.basename(clip)} -> {frames} frames @ {out_fps:g} fps "
          f"({out_w}x{out_h}) in {out_dir}")


if __name__ == "__main__":
    main(sys.argv[1:])
